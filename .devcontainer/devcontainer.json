{
  "name": "Temporal learning lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",

  "features": {
    // Only needed by bootstrap_server.sh's fallback path, which builds the
    // Temporal CLI from source when temporal.download is unreachable.
    // Codespaces can normally reach it, so this is belt and braces.
    "ghcr.io/devcontainers/features/go:1": { "version": "1.24" }
  },

  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  // 7233 is the gRPC endpoint your Worker and Client talk to.
  // 8233 is the Web UI -- this is the one to open in your browser.
  "forwardPorts": [7233, 8233],
  "portsAttributes": {
    "8233": {
      "label": "Temporal Web UI",
      "onAutoForward": "openBrowser"
    },
    "7233": {
      "label": "Temporal gRPC",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
